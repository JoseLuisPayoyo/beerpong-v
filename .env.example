# Supabase — claves de CLIENTE. En Astro las vars públicas van con prefijo PUBLIC_.
# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — clave de SERVIDOR (secret). SIN prefijo PUBLIC_ para que NUNCA llegue al navegador.
# Solo la usa POST /api/sugerencia. En Vercel, añádela también (Production y Preview).
SUPABASE_SECRET_KEY=
